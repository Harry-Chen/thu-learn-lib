{
  "name": "thu-learn-lib",
  "version": "4.2.6",
  "description": "a JavaScript library to provide a program-friendly interface to Web Learning (2018) of Tsinghua University",
  "keywords": [
    "learn2018",
    "tsinghua"
  ],
  "license": "MIT",
  "author": "Harry Chen <harry-chen@outlook.com> (https://harrychen.xyz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harry-Chen/thu-learn-lib.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "browser": "lib/index.iife.js",
  "types": "./lib/index.d.ts",
  "unpkg": "lib/index.iife.js",
  "jsdelivr": "lib/index.iife.js",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./lib/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "entities": "^8.1.0",
    "js-base64": "^3.9.4",
    "node-fetch-native": "^1.6.7",
    "sm-crypto": "^0.5.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/sm-crypto": "^0.3.4",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
