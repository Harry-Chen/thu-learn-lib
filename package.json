{
  "name": "thu-learn-lib",
  "version": "4.2.6",
  "description": "a JavaScript library to provide a program-friendly interface to Web Learning (2018) of Tsinghua University",
  "keywords": [
    "tsinghua",
    "learn2018"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harry-Chen/thu-learn-lib.git"
  },
  "license": "MIT",
  "author": "Harry Chen <harry-chen@outlook.com> (https://harrychen.xyz)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "jsdelivr": "lib/index.iife.js",
  "unpkg": "lib/index.iife.js",
  "browser": "lib/index.iife.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "format": "prettier --write \"{src,test,demo}/**/*.{ts,html,json}\" \"*.{ts,md,json}\"",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "entities": "^7.0.1",
    "js-base64": "^3.9.3",
    "node-fetch-native": "^1.6.7",
    "sm-crypto": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/sm-crypto": "^0.3.4",
    "domhandler": "^5.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.32.0",
  "publishConfig": {
    "exports": {
      ".": "./lib/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "inlinedDependencies": {
    "boolbase": "1.0.0",
    "cheerio": "1.2.0",
    "cheerio-select": "2.1.0",
    "css-select": "5.2.2",
    "css-what": "6.2.2",
    "dom-serializer": "2.0.0",
    "domelementtype": "2.3.0",
    "domhandler": "5.0.3",
    "domutils": "3.2.2",
    "entities": "7.0.1",
    "fake-parse5": "0.0.2",
    "htmlparser2": "10.1.0",
    "js-base64": "3.9.3",
    "jsbn": "1.1.0",
    "node-fetch-native": "1.6.7",
    "nth-check": "2.1.1",
    "sm-crypto": "0.4.0"
  }
}
